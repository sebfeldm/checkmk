#!/bin/bash
# -*- coding: utf-8; sh-basic-offset: 4 -*-

####################################################################################################
# CHECKMK AGENT PLUG-IN: SAP ASE (Sybase) Databases
#
# Collects raw monitoring data of one or more SAP ASE instances. No states or thresholds are
# evaluated here: this is done on the Checkmk server by the check plug-ins of "check_sybase",
# configurable via rules in the Checkmk GUI.
# This file is part of the "check_sybase" agent plug-in.
#
# Installation (runs asynchronously every 300 seconds):
#   /usr/lib/check_mk_agent/plugins/300/check_sybase
#
# Configuration (see cfg_examples/check_sybase.cfg, should be owned by root with mode 0600):
#   ${MK_CONFDIR}/check_sybase.cfg (default: /etc/check_mk/check_sybase.cfg)
####################################################################################################

# Output (fields separated by ';', optional fields may be empty):
# <<<check_sybase:sep(59)>>>
# instance;<SID>;dataserver;<0|1>
# instance;<SID>;backupserver;<0|1>
# instance;<SID>;connect;<rc>;<message>
# db;<SID>;<db>;<data MB>;<used data MB>;<log MB>;<free log MB>;<last backup epoch>;<backup failed>
# errorlog;<SID>;<ok|missing>;<window hours>;<matching lines>;<path>
# errorlog_line;<SID>;<YYYY/MM/DD HH:MM:SS>;<message>

CONFIG_FILE="${MK_CONFDIR:-/etc/check_mk}/check_sybase.cfg"

# Only the last lines are sent to the server, the total count is always sent.
ERRORLOG_MAX_LINES=20

# Marker column to find the data rows in the isql output.
SQL_MARKER="CMKDB"

# Age of the last backup in minutes: datediff() returns an int, so seconds would overflow for
# timestamps like 1900-01-01. Minutes also avoid time zone issues, as they are relative to the
# clock of the ASE server.
SQL_QUERY="set nocount on
go
use master
go
declare @pagesize numeric(19,0)
select @pagesize = @@maxpagesize
select
    '${SQL_MARKER}',
    convert(varchar(255), db_name(M.DBID)),
    str(sum(case when U.segmap != 4 then U.size else 0 end) * @pagesize / 1048576, 20, 2),
    str(sum(case when U.segmap != 4
        then U.size - curunreservedpgs(U.dbid, U.lstart, U.unreservedpgs) else 0 end)
        * @pagesize / 1048576, 20, 2),
    str(sum(case when U.segmap = 4 then U.size else 0 end) * @pagesize / 1048576, 20, 2),
    str(lct_admin('logsegment_freepages', M.DBID) * @pagesize / 1048576, 20, 2),
    datediff(mi, M.BackupStartTime, getdate()),
    M.LastBackupFailed
from master..sysusages U, master..monOpenDatabases M
where U.dbid = M.DBID
group by M.DBID, M.BackupStartTime, M.LastBackupFailed
order by db_name(M.DBID)
go"

declare -A CFG
SIDS=()

read_config() {
    local line section="" key
    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line%$'\r'}"
        case "${line}" in
            "" | "#"*) continue ;;
            "["*"]")
                section="${line#[}"
                section="${section%]}"
                SIDS+=("${section}")
                continue
                ;;
        esac
        [[ "${line}" == *=* ]] || continue
        key="${line%%=*}"
        key="${key//[[:space:]]/}"
        # Values are used verbatim (no trimming), passwords may contain any character.
        CFG["${section}|${key}"]="${line#*=}"
    done <"${CONFIG_FILE}"
}

# Usage: cfg SID KEY DEFAULT
# Instance setting > global setting (before the first [SID] section) > default.
cfg() {
    if [ -n "${CFG["$1|$2"]+x}" ]; then
        printf '%s' "${CFG["$1|$2"]}"
    elif [ -n "${CFG["|$2"]+x}" ]; then
        printf '%s' "${CFG["|$2"]}"
    else
        printf '%s' "$3"
    fi
}

# Fields must not contain the separator or line breaks.
sanitize() {
    tr ';\n\r\t' ',   '
}

check_processes() {
    local sid="$1" os_user="$2" process
    for process in dataserver backupserver; do
        if pgrep -u "${os_user}" -f "${process}" >/dev/null 2>&1; then
            echo "instance;${sid};${process};1"
        else
            echo "instance;${sid};${process};0"
        fi
    done
}

query_databases() {
    local sid="$1" os_user="$2"
    local user password password_via timeout isql_cmd output rc now message

    user=$(cfg "${sid}" user "")
    password=$(cfg "${sid}" password "")
    password_via=$(cfg "${sid}" password_via "stdin")
    timeout=$(cfg "${sid}" timeout "60")

    if [ -z "${user}" ] || [ -z "${password}" ]; then
        echo "instance;${sid};connect;1;user or password missing in ${CONFIG_FILE}"
        return
    fi

    isql_cmd="isql -S$(printf '%q' "${sid}") -U$(printf '%q' "${user}") -X -b -w 9999 -s ';'"
    if [ "${password_via}" = "argv" ]; then
        # Fallback only: the password is visible in the process list while isql runs.
        isql_cmd="${isql_cmd} -P$(printf '%q' "${password}")"
        output=$(printf '%s\n' "${SQL_QUERY}" |
            timeout "${timeout}" su - "${os_user}" -c "${isql_cmd}" 2>&1)
    else
        # Without -P, isql reads the password from the first line of stdin.
        output=$(printf '%s\n%s\n' "${password}" "${SQL_QUERY}" |
            timeout "${timeout}" su - "${os_user}" -c "${isql_cmd}" 2>&1)
    fi
    rc=$?

    now=$(date +%s)
    local rows
    rows=$(printf '%s\n' "${output}" | awk -F ';' -v sid="${sid}" -v marker="${SQL_MARKER}" -v now="${now}" '
        {
            start = 0
            for (i = 1; i <= NF; i++) {
                gsub(/^[ \t]+|[ \t]+$/, "", $i)
                if (!start && $i == marker) start = i
            }
            if (!start) next
            age = $(start + 6)
            backup = (age ~ /^-?[0-9]+$/) ? now - age * 60 : ""
            failed = $(start + 7)
            if (failed !~ /^[0-9]+$/) failed = ""
            printf "db;%s;%s;%s;%s;%s;%s;%s;%s\n", sid, $(start + 1), $(start + 2), $(start + 3),
                $(start + 4), $(start + 5), backup, failed
        }')

    if [ "${rc}" -eq 124 ]; then
        echo "instance;${sid};connect;${rc};isql timed out after ${timeout} seconds"
    elif [ "${rc}" -ne 0 ] || [ -z "${rows}" ]; then
        [ "${rc}" -eq 0 ] && rc=1
        # First line that looks like an error plus the two lines after it (isql prints the
        # message text below the "Msg ..." line), otherwise the first non-empty lines.
        output=$(printf '%s\n' "${output}" | grep -v -i -E '^[[:space:]]*(password:[[:space:]]*)?$')
        message=$(printf '%s\n' "${output}" | awk '
            !found && tolower($0) ~ /msg|error|fail|login|not found|denied/ { found = NR }
            found && NR < found + 3')
        [ -z "${message}" ] && message=$(printf '%s\n' "${output}" | head -n 3)
        [ -z "${message}" ] && message="no data returned by isql"
        echo "instance;${sid};connect;${rc};$(printf '%s' "${message}" | sanitize | cut -c 1-300)"
    else
        echo "instance;${sid};connect;0;OK"
        printf '%s\n' "${rows}"
    fi
}

check_errorlog() {
    local sid="$1" errorlog window pattern grep_case cutoff
    errorlog=$(cfg "${sid}" errorlog "/sybase/${sid}/ASE-16_0/install/${sid}.log")
    window=$(cfg "${sid}" errorlog_window "24")
    pattern=$(cfg "${sid}" errorlog_pattern "error:|error ")
    case "$(cfg "${sid}" errorlog_ignore_case "yes")" in
        yes | 1 | true) grep_case="-i" ;;
        *) grep_case="" ;;
    esac

    [ "${errorlog}" = "off" ] && return

    if [ ! -r "${errorlog}" ]; then
        echo "errorlog;${sid};missing;${window};0;${errorlog}"
        return
    fi

    # Timestamps in the errorlog are local time: "00:0002:00000:00017:2025/02/11 10:15:32.45 ..."
    # Comparing them as strings to the cutoff in the same format avoids a date call per line.
    cutoff=$(date -d "-${window} hours" '+%Y/%m/%d %H:%M:%S')

    grep -E ${grep_case} -- "${pattern}" "${errorlog}" 2>/dev/null |
        awk -v sid="${sid}" -v cutoff="${cutoff}" -v window="${window}" -v path="${errorlog}" \
            -v max="${ERRORLOG_MAX_LINES}" '
        {
            n = split($1, head, ":")
            date = head[n]
            if (date !~ /^[0-9][0-9][0-9][0-9]\/[0-9][0-9]\/[0-9][0-9]$/) next
            ts = date " " substr($2, 1, 8)
            if (ts < cutoff) next
            # The message starts after the first double space ("... server  Error: 1105, ...").
            pos = index($0, "  ")
            if (!pos) next
            msg = substr($0, pos + 2)
            sub(/^[ \t]+/, "", msg)
            gsub(/[;\r\t]/, ",", msg)
            if (msg == "") next
            count++
            lines[count % max] = ts ";" msg
        }
        END {
            printf "errorlog;%s;ok;%s;%d;%s\n", sid, window, count, path
            first = (count > max) ? count - max + 1 : 1
            for (i = first; i <= count; i++) printf "errorlog_line;%s;%s\n", sid, lines[i % max]
        }'
}

main() {
    [ -r "${CONFIG_FILE}" ] || exit 0
    read_config
    [ "${#SIDS[@]}" -gt 0 ] || exit 0

    echo "<<<check_sybase:sep(59)>>>"
    local sid os_user
    for sid in "${SIDS[@]}"; do
        os_user=$(cfg "${sid}" os_user "syb${sid,,}")
        check_processes "${sid}" "${os_user}"
        query_databases "${sid}" "${os_user}"
        check_errorlog "${sid}"
    done
}

[ -z "${MK_SOURCE_ONLY}" ] && main
